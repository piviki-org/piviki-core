# Local development only (copy to .env). Hosts get these from /etc/piviki/core.env.
DATABASE_URL=postgres://piviki:piviki@127.0.0.1:5432/piviki
# local, test or production; on a host deploy.sh passes it from /etc/piviki/environment. Core
# refuses to start when a host name below disagrees with it (local: only *.localhost).
ENVIRONMENT=local
PAYLOAD_SECRET=local-only-payload-secret-not-for-any-host-0123456789
SERVER_URL=http://admin.localhost:3000
CORS_ORIGINS=http://admin.localhost:3000
CSRF_ORIGINS=http://admin.localhost:3000
