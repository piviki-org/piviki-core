# Local development values only. Real values live in /etc/piviki/core.env on each host.
DATABASE_URL=postgres://piviki_core:local-core-db-password@postgres:5432/piviki
PAYLOAD_SECRET=local-only-payload-secret-not-for-any-host-0123456789
SERVER_URL=http://admin.localhost:8080
CORS_ORIGINS=http://admin.localhost:8080
CSRF_ORIGINS=http://admin.localhost:8080
