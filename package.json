{
  "name": "piviki-core",
  "version": "0.1.0",
  "private": true,
  "description": "Piviki core: Payload CMS and Next.js, the only system that holds state",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.28.10",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "seed:librarian": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/seed-librarian.ts",
    "test": "cross-env NODE_OPTIONS=--no-deprecation vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.92.1",
    "@payloadcms/next": "3.92.1",
    "@payloadcms/ui": "3.92.1",
    "cross-env": "10.1.0",
    "graphql": "16.14.2",
    "next": "16.4.5",
    "payload": "3.92.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "embedded-postgres": "18.6.0-beta.19",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
